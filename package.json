{
  "name": "portifolio-thiago-araujo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "media": "node scripts/optimize-media.mjs",
    "dev": "npm run media && vite",
    "build": "npm run media && vite build && vite build --ssr src/entry-server.tsx --outDir dist-server && node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/inter-tight": "^5.3.0",
    "preact": "^10.29.8",
    "preact-render-to-string": "^6.7.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.0",
    "vite": "^8.3.1"
  },
  "engines": {
    "node": ">=20"
  }
}
